# Copia este archivo como .env.local y llena los valores (nunca subas .env.local a Git).
# Access Token de PRUEBA de Mercado Pago (Tus integraciones → Credenciales de prueba)
MP_ACCESS_TOKEN=
# Clave secreta de las notificaciones (Tus integraciones → Webhooks)
MP_WEBHOOK_SECRET=
# URL base de la app: http://localhost:3000 en local, la URL de Vercel en producción
NEXT_PUBLIC_BASE_URL=http://localhost:3000
